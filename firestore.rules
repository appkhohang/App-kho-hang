rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper checking if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Safe validation of document ID to protect against bad inputs and prevent overflow
    function isValidId(id) {
      return id is string && id.size() <= 256;
    }

    // Checks if the collection name is a standard collection or partitioned collaborative space
    function isValidCollection(colName) {
      return colName == 'import_items' || 
             colName == 'tp_dt_shippings' || 
             colName == 'labor_payments' || 
             colName == 'customers' || 
             colName == 'bills' || 
             colName == 'payments' || 
             colName == 'operation_breakdowns' || 
             colName == 'workers' || 
             colName == 'worker_jobs' || 
             colName == 'raw_materials' || 
             colName == 'material_recipes' || 
             colName == 'production_batches' || 
             colName == 'material_reimports' || 
             colName == 'login_notifications' || 
             colName == 'settings' || 
             colName == 'tasks' || 
             colName == 'user_profiles' ||
             colName.matches('^group_.*');
    }

    // Catch-all rule for other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for all valid collections
    match /{collectionName}/{id} {
      allow read: if isSignedIn() && isValidCollection(collectionName);
      allow write: if isSignedIn() && isValidId(id) && isValidCollection(collectionName);
    }
  }
}
