rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety catch-all: Deny all operations by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SECURITY PRIMITIVES ---
    
    // Checks if the client has a valid active authenticated session
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user is signed in with a Google-verified email address
    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // RESTRICTED ADMIN RULE: Only allow the owner of the workspace (vukuli.123@gmail.com)
    function isAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'vukuli.123@gmail.com';
    }

    // Checks if the user is a registered user with an active profile in user_profiles, or the master Admin
    function isAuthorizedUser() {
      return isSignedIn() && (
        request.auth.token.email == 'vukuli.123@gmail.com' ||
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.token.email.lower()))
      );
    }

    // Input Sanitization to prevent resource/ID poisoning attacks
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Input Sanitization specifically for email-based IDs to support dots, @, + symbols
    function isValidEmailId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+\\.@]+$');
    }

    // --- COLLECTION PROTECTION ---

    match /import_items/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /tp_dt_shippings/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /labor_payments/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /customers/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /bills/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /payments/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /operation_breakdowns/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /workers/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /worker_jobs/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /raw_materials/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /material_recipes/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /production_batches/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /material_reimports/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /login_notifications/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /settings/{id} {
      allow read, write: if isAdmin() && isValidId(id);
    }

    match /tasks/{id} {
      allow read, write: if isAuthorizedUser() && isValidId(id);
    }

    match /user_profiles/{id} {
      allow read: if isAdmin() || (isSignedIn() && (id == request.auth.token.email || id == request.auth.token.email.lower()));
      allow write: if isAdmin() && isValidEmailId(id);
    }
  }
}
